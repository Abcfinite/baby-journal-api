-- accurate but too gain is too small

update table_tennis_matches 
set bet_on = 2, notes = COALESCE(notes, '') || 'qCv11 '
where winner is null
	and bet_on is null
	and p1_lost_lost - p2_lost_lost > 2
	and p1_lost_lost > 0
	and prediction_p1_odd_only_win < 0.5;


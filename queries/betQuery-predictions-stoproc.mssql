CREATE OR REPLACE PROCEDURE update_predictions()
LANGUAGE plpgsql
AS $$
BEGIN

	update table_tennis_matches set p1_p1last = null where LENGTH(p1_p1last) > 7 and winner is null;
	update table_tennis_matches set p1_p2last = null where LENGTH(p1_p2last) > 7 and winner is null;
	update table_tennis_matches set p2_p1last = null where LENGTH(p2_p1last) > 7 and winner is null;
	update table_tennis_matches set p2_p2last = null where LENGTH(p2_p2last) > 7 and winner is null;
	update table_tennis_matches set p1_p1last = '' where p1_p1last is null and winner is null;
	update table_tennis_matches set p1_p2last = '' where p1_p2last is null and winner is null;
	update table_tennis_matches set p2_p1last = '' where p2_p1last is null and winner is null;
	update table_tennis_matches set p2_p2last = '' where p2_p2last is null and winner is null;

-- 	update table_tennis_matches set prediction_2_p1_win = NULL, prediction_2_p1_win_count = NULL, prediction_2_match_no = NULL;

	UPDATE table_tennis_matches AS target
	SET 
	  prediction_2_p1_win = stats.percentage,
	  prediction_2_p1_win_count = stats.sum_p1_won,
	  prediction_2_match_no = stats.match_count
	FROM (
	  SELECT 
		p1_p1last,
		p1_p2last,
		p2_p1last,
		p2_p2last,
	-- 	bm_p1,
	-- 	bm_p2,
	-- 	h2h_streak_win_rate,
	-- 	h2h_p1 - h2h_p2 as h2h_gap,
	-- 	bm_p1 - bm_p2 as bm_gap,
	-- 	p1_streak,
	-- 	p2_streak,
		sum(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS sum_p1_won,
		AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage,
		COUNT(*) AS match_count
	  FROM table_tennis_matches
	  WHERE winner IS NOT NULL
	  GROUP BY p1_p1last, p1_p2last, p2_p1last, p2_p2last --, p1_streak, p2_streak
	) AS stats
	WHERE
	  target.p1_p1last = stats.p1_p1last 
	  AND target.p1_p2last = stats.p1_p2last
	  AND target.p2_p1last = stats.p2_p1last
	  AND target.p2_p2last = stats.p2_p2last
	  AND target.winner is null;


----------------------------------------------------------------------------------------------------------

-- 	UPDATE table_tennis_matches set h2h_streak_win_rate = null, h2h_streak_match_count = null;

	UPDATE table_tennis_matches AS target
	SET 
	  h2h_streak_win_rate = stats.percentage,
	  h2h_streak_match_count = stats.match_count
	FROM (
	  SELECT 
		h2h_p1
		, h2h_p2
		, p1_streak
		, p2_streak
		, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage
		, COUNT(*) AS match_count
	  FROM table_tennis_matches
	  WHERE winner is not null 
	  GROUP BY h2h_p1, h2h_p2, p1_streak, p2_streak 
	) AS stats
	WHERE 
		target.h2h_p1 = stats.h2h_p1 
		AND target.h2h_p2 = stats.h2h_p2
		AND target.p1_streak = stats.p1_streak
		AND target.p2_streak = stats.p2_streak
		AND target.winner is null;

------------------------------------------------------------------------------------------------------------

	UPDATE table_tennis_matches AS target
	SET 
	  lost_won_rate = stats.percentage,
	  lost_won_p1_win_count = stats.sum_p1_won,
	  lost_won_count = stats.match_count
	FROM (
	  SELECT 
		p1_won_won, p2_won_won
		, p1_won_lost, p2_won_lost
		, p1_lost_won, p2_lost_won
		, p1_lost_lost, p2_lost_lost
		, SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS sum_p1_won
		, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage
		, COUNT(*) AS match_count
	  FROM table_tennis_matches
	  WHERE winner is not null 
	  GROUP BY p1_won_won, p2_won_won
		, p1_won_lost, p2_won_lost
		, p1_lost_won, p2_lost_won
		, p1_lost_lost, p2_lost_lost
	) AS stats
	WHERE 
		target.p1_won_won = stats.p1_won_won 
		AND target.p2_won_won = stats.p2_won_won
		AND target.p1_won_lost = stats.p1_won_lost
		AND target.p2_won_lost = stats.p2_won_lost
		AND target.p1_lost_won = stats.p1_lost_won
		AND target.p2_lost_won = stats.p2_lost_won
		AND target.p1_lost_lost = stats.p1_lost_lost
		AND target.p2_lost_lost = stats.p2_lost_lost
		AND target.winner is null;
		
		
-- 		update table_tennis_matches set streak_score = NULL, plast_score = NULL, pwon_last_score = NULL;


		update table_tennis_matches set 
			streak_score = convert_wwll_to_integer_with_sign(p1_streak) - convert_wwll_to_integer_with_sign(p2_streak),
			plast_score = (convert_wwll_to_integer_last_chars(p1_p1last) - convert_wwll_to_integer_last_chars(p2_p1last)) + (convert_wwll_to_integer_last_chars(p1_p2last) - convert_wwll_to_integer_last_chars(p2_p2last)),
			pwon_last_score = (((p1_won_won - p2_won_won) + ((p1_lost_won * 2)- (p2_lost_won * 2))) - ((p2_won_lost - p1_won_lost) + (p2_lost_lost - p1_lost_lost)))
			where winner is null;






-- 	update table_tennis_matches set pred2_streak_rate = NULL, pred2_streak_count = NULL;

-- 	UPDATE table_tennis_matches AS target
-- 	SET 
-- 	  pred2_streak_rate = stats.percentage,
-- 	  pred2_streak_count = stats.match_count
-- 	FROM (
-- 	  SELECT 
-- 		p1_streak
-- 		, p2_streak
-- 		, prediction_p1_win

-- 		, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage,
-- 		COUNT(*) AS match_count
-- 	  FROM table_tennis_matches
-- 	  WHERE winner is not null 
-- 	  GROUP BY p1_streak, p2_streak, prediction_p1_win 
-- 	) AS stats
-- 	WHERE 
-- 		target.p1_streak = stats.p1_streak
-- 		AND target.p2_streak = stats.p2_streak
-- 		AND target.prediction_p1_win = stats.prediction_p1_win;




-- 		UPDATE table_tennis_matches AS target
-- 		SET 
-- 		  prediction_streak_p1_win = stats.percentage,
-- 		  prediction_streak_match_no = stats.match_count
-- 		FROM (
-- 		  SELECT 
-- 			p1_streak
-- 			, p2_streak

-- 			, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage,
-- 			COUNT(*) AS match_count
-- 		  FROM table_tennis_matches
-- 		  WHERE winner is not null 
-- 		  GROUP BY p1_streak, p2_streak
-- 		) AS stats
-- 		WHERE 
-- 			target.p1_streak = stats.p1_streak
-- 			AND target.p2_streak = stats.p2_streak;





-- 		UPDATE table_tennis_matches AS target
-- 		SET 
-- 		  prediction_p1_win = stats.percentage,
-- 		  prediction_p1_win_count = stats.sum_p1_won,
-- 		  prediction_match_no = stats.match_count
-- 		FROM (


-- 			SELECT 
-- 			prediction_streak_p1_win
-- 			, plast_score
-- 			, pwon_last_score
-- 			, SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS sum_p1_won
-- 			, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage
-- 			, COUNT(*) AS match_count

-- 			FROM table_tennis_matches
-- 		  WHERE winner IS NOT NULL	
-- 		  GROUP BY prediction_streak_p1_win, plast_score, pwon_last_score

-- 		) AS stats
-- 		WHERE
-- 		  target.prediction_streak_p1_win = stats.prediction_streak_p1_win
-- 		  and target.pLast_score = stats.pLast_score
-- 		  and target.pwon_last_score = stats.pwon_last_score;


----------------------------------------------------------------------------------------------------------------------


-- 		UPDATE table_tennis_matches AS t set prediction_2_rev_p1_win = null, prediction_2_rev_match_no = null;

		UPDATE table_tennis_matches AS t
		SET prediction_2_rev_p1_win = p1_won_avg,
			prediction_2_rev_p1_win_count = p1_won_sum,
			prediction_2_rev_match_no = match_count
		FROM (
			SELECT
				plast_score,
				pwon_last_score,
				SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum,
				AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg,
				COUNT(*) AS match_count
			FROM table_tennis_matches
			WHERE winner IS NOT NULL
			GROUP BY
				plast_score,
				pwon_last_score
		) AS s
		WHERE
			t.plast_score = s.plast_score
			AND t.pwon_last_score = s.pwon_last_score
			AND t.winner is null;
			
			
----------------------------------------------------------------------------------------------------------------------

-- 		UPDATE table_tennis_matches set prediction_p1_test2 = null;

		UPDATE table_tennis_matches AS t
		SET prediction_3 = s.p1_won_avg
			, prediction_3_win_count = s.p1_won_sum
			, prediction_3_count = s.match_count
		FROM (
			SELECT
				prediction_2_rev_p1_win
				, streak_score
				, pLast_score
				, pwon_last_score
				, SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum
				, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg
				, COUNT(*) AS match_count
			FROM table_tennis_matches
			WHERE winner IS NOT NULL
			GROUP BY
				prediction_2_rev_p1_win
				, streak_score
				, pLast_score
				, pwon_last_score
		) AS s
		WHERE
			t.prediction_2_rev_p1_win = s.prediction_2_rev_p1_win
			and t.streak_score = s.streak_score
			and t.pLast_score = s.pLast_score
			and t.pwon_last_score = s.pwon_last_score
			AND t.winner is null;


----------------------------------------------------------------------------------------------------------


-- 		UPDATE table_tennis_matches AS t set prediction_p1_test = null;

-- 		UPDATE table_tennis_matches AS t
-- 		SET prediction_p1_test =  s.p1_won_sum || '/' || s.p2_won_sum::varchar || '/' || s.match_count::varchar
-- 		FROM (
-- 			SELECT
-- 				p1_won_won, p2_won_won
-- 				, p1_won_lost, p2_won_lost
-- 				, p1_lost_won, p2_lost_won
-- 				, p1_lost_lost, p2_lost_lost
-- 		--         , h2h_p1 - h2h_p2 as h2h_gap
-- 				, SUM(CASE WHEN winner = 1 and (set_score = '3-0' or set_score = '0-3') THEN 1.0 ELSE 0 END) AS p1_won_sum
-- 				, SUM(CASE WHEN winner = 2 and (set_score = '3-0' or set_score = '0-3') THEN 1.0 ELSE 0 END) AS p2_won_sum        
-- 				, COUNT(*) AS match_count
-- 			FROM table_tennis_matches
-- 			WHERE winner IS NOT NULL
-- 			GROUP BY p1_won_won, p2_won_won
-- 				, p1_won_lost, p2_won_lost
-- 				, p1_lost_won, p2_lost_won
-- 				, p1_lost_lost, p2_lost_lost
-- 		--         , h2h_p1
-- 		-- 		, h2h_p2

-- 		) AS s
-- 		WHERE
-- 			t.p1_won_won = s.p1_won_won 
-- 			AND t.p2_won_won = s.p2_won_won
-- 			AND t.p1_won_lost = s.p1_won_lost
-- 			AND t.p2_won_lost = s.p2_won_lost
-- 			AND t.p1_lost_won = s.p1_lost_won
-- 			AND t.p2_lost_won = s.p2_lost_won
-- 			AND t.p1_lost_lost = s.p1_lost_lost
-- 			AND t.p2_lost_lost = s.p2_lost_lost;
-- 		-- 	AND t.h2h_p1 - t.h2h_p2 = s.h2h_gap

----------------------------------------------------------------------------------------------------------


-- 	UPDATE table_tennis_matches SET prediction_streak_p1_win = null, prediction_streak_match_no = null;



-- 	UPDATE table_tennis_matches AS target
-- 	SET 
-- 	  prediction_raw_p1 = stats.percentage,
-- 	  prediction_raw_win_count = stats.sum_p1_won,
-- 	  prediction_raw_count = stats.match_count
-- 	FROM (
-- 	  SELECT 
-- 		p1_won_won, p2_won_won
-- 		, p1_won_lost, p2_won_lost
-- 		, p1_lost_won, p2_lost_won
-- 		, p1_lost_lost, p2_lost_lost
-- 		, p1_p1last, p1_p2last
-- 		, p2_p1last, p2_p2last
-- 		, SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS sum_p1_won
-- 		, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS percentage
-- 		, COUNT(*) AS match_count
-- 	  FROM table_tennis_matches
-- 	  WHERE winner is not null 
-- 	  GROUP BY p1_won_won, p2_won_won
-- 		, p1_won_lost, p2_won_lost
-- 		, p1_lost_won, p2_lost_won
-- 		, p1_lost_lost, p2_lost_lost
-- 		, p1_p1last, p1_p2last
-- 		, p2_p1last, p2_p2last
-- 	) AS stats
-- 	WHERE 
-- 		target.p1_won_won = stats.p1_won_won 
-- 		AND target.p2_won_won = stats.p2_won_won
-- 		AND target.p1_won_lost = stats.p1_won_lost
-- 		AND target.p2_won_lost = stats.p2_won_lost
-- 		AND target.p1_lost_won = stats.p1_lost_won
-- 		AND target.p2_lost_won = stats.p2_lost_won
-- 		AND target.p1_lost_lost = stats.p1_lost_lost
-- 		AND target.p2_lost_lost = stats.p2_lost_lost
-- 		AND target.p1_p1last = stats.p1_p1last
-- 		AND target.p1_p2last = stats.p1_p2last
-- 		AND target.p2_p1last = stats.p2_p1last
-- 		AND target.p2_p2last = stats.p2_p2last;


-- UPDATE table_tennis_matches AS t set clean_sheet_p1_count = null, clean_sheet_p2_count = null;

UPDATE table_tennis_matches AS t
SET 
	clean_sheet_p1_count = p1_won_sum
	, clean_sheet_p2_count = p2_won_sum
FROM (
    SELECT
        h2h_p1
		, h2h_p2
		, p1_streak
		, p2_streak
        , SUM(CASE WHEN winner = 1 and (set_score = '3-0' or set_score = '0-3') THEN 1.0 ELSE 0 END) AS p1_won_sum
        , SUM(CASE WHEN winner = 2 and (set_score = '3-0' or set_score = '0-3') THEN 1.0 ELSE 0 END) AS p2_won_sum        
		, COUNT(*) AS match_count
    FROM table_tennis_matches
    WHERE winner IS NOT NULL
  	GROUP BY 
        h2h_p1
		, h2h_p2
		, p1_streak
		, p2_streak

) AS s
WHERE
	t.h2h_p1 = s.h2h_p1 
	AND t.h2h_p2 = s.h2h_p2	  
	AND t.p1_streak = s.p1_streak
	AND t.p2_streak = s.p2_streak
	AND t.winner is null;

----------------------------------------------------------------------------------------------------------


-- UPDATE table_tennis_matches AS t set prediction_raw_p1 = null;

UPDATE table_tennis_matches AS t
set prediction_raw_p1 =  avggg
	, prediction_raw_count =  match_count
FROM (
    SELECT
        clean_sheet_p1_count
		, clean_sheet_p2_count
		, h2h_streak_match_count
        , AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS avggg        
		, COUNT(*) AS match_count
    FROM table_tennis_matches
    WHERE winner IS NOT NULL
  	GROUP BY 
        clean_sheet_p1_count
		, clean_sheet_p2_count
		, h2h_streak_match_count

) AS s
WHERE
	t.clean_sheet_p1_count = s.clean_sheet_p1_count
	and t.clean_sheet_p2_count = s.clean_sheet_p2_count
	and t.h2h_streak_match_count = s.h2h_streak_match_count
	AND t.winner is null;

----------------------------------------------------------------------------------------------------------



UPDATE table_tennis_matches AS t
set prediction_h2h_scores_rate =  avggg
	, prediction_h2h_scores_count =  match_count
FROM (
    SELECT
        h2h_p1
		, h2h_p2
		, streak_score
		, plast_score
		, pwon_last_score
        , AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS avggg        
		, COUNT(*) AS match_count
    FROM table_tennis_matches
    WHERE winner IS NOT NULL
  	GROUP BY 
        h2h_p1
		, h2h_p2
		, streak_score
		, plast_score
		, pwon_last_score
) AS s
WHERE
	t.h2h_p1 = s.h2h_p1 
	AND t.h2h_p2 = s.h2h_p2	  
	AND t.streak_score = s.streak_score
	AND t.plast_score = s.plast_score
	AND t.pwon_last_score = s.pwon_last_score
	AND t.winner is null;



----------------------------------------------------------------------------------------------------------


update table_tennis_matches set prediction_3_on = prediction_3 where winner is null;
update table_tennis_matches set prediction_3_count_on = prediction_3_count where winner is null;
update table_tennis_matches set prediction_2_p1_win_on = prediction_2_p1_win where winner is null;
update table_tennis_matches set prediction_2_match_no_on = prediction_2_match_no where winner is null;
update table_tennis_matches set prediction_2_rev_p1_win_on = prediction_2_rev_p1_win where winner is null;
update table_tennis_matches set prediction_2_rev_match_no_on = prediction_2_rev_match_no where winner is null;
update table_tennis_matches set lost_won_rate_on = lost_won_rate where winner is null;
update table_tennis_matches set lost_won_count_on = lost_won_count where winner is null;
update table_tennis_matches set h2h_streak_win_rate_on = h2h_streak_win_rate where winner is null;
update table_tennis_matches set h2h_streak_match_count_on = h2h_streak_match_count where winner is null;

update table_tennis_matches set prediction_raw_p1_on = prediction_raw_p1 where winner is null;
update table_tennis_matches set prediction_raw_count_on = prediction_raw_count where winner is null;

-- update table_tennis_matches set prediction_raw_win_count_on = prediction_raw_win_count_on where winner is null;
-- update table_tennis_matches set prediction_p1_test_on = prediction_p1_test where winner is null;

----------------------------------------------------------------------------------------------------------
--- qA ---

-- stable query criteria :
-- > same pattern everyday
-- > lost in a row max 2
	--> 10670645, 10671945

-- CASHOUT :
-- ON LEAD and overtime
-- 2-0
-- 2-1
-- 2-2 and on lead by 2
	-- this is save bet for 2 matches already

update table_tennis_matches 
set bet_on = 1, notes = 'qAv6'
where winner is null
	and h2h_streak_win_rate > 0.6
	and prediction_2_p1_win > 0.6
	and ( prediction_h2h_scores_rate > 0.6 or prediction_h2h_scores_rate is null );

	
	
-- update table_tennis_matches 
-- set bet_on = 2, notes = 'qAv6'
-- where winner is null
-- 	and h2h_streak_win_rate < 0.4
-- 	and prediction_2_p1_win < 0.4
-- 	and ( prediction_h2h_scores_rate < 0.4 or prediction_h2h_scores_rate is null );


----------------------------------------------------------------------------------------------------------
-- qB ---

------------------------
--- ALWAYS CASHOUT ON --
--- 2v2 + (x v x+2) ----
------------------------

update table_tennis_matches 
set bet_on = 1, notes = 'qBv15'
where winner is null
	and ( h2h_streak_win_rate != 0.5 and prediction_3 != 0.5 and prediction_2_p1_win != 0.5 )
	and prediction_raw_p1 > 0.7
	and h2h_streak_match_count > 1
	and prediction_3 > 0.4
	and prediction_2_p1_win > 0.3
 	and (lost_won_rate_on is null or lost_won_rate > 0.34);


update table_tennis_matches 
set bet_on = 2, notes = 'qBv15'
where winner is null
	and ( h2h_streak_win_rate != 0.5 and prediction_3 != 0.5 and prediction_2_p1_win != 0.5 )
	and ( prediction_2_rev_p1_win < 0.6 and prediction_2_p1_win < 0.68 ) -- 10714656
	and prediction_raw_p1 < 0.3
	and h2h_streak_match_count > 1
  	and h2h_streak_win_rate < 0.8
  	and prediction_3 < 0.8
  	and lost_won_rate < 0.75
	and prediction_2_p1_win < 0.8;


----------------------------------------------------------------------------------------------------------

-- accuracy : 0.73
-- qCv2 not stable : 
	-- 2025.09.26 - 0.42 (5/12)
	-- 2025.09.25 - 0.89 (16/18)
		
update table_tennis_matches 
set bet_on = 1, notes = 'qCv3'
where winner is null
	and h2h_p1 - h2h_p2 > 2
   	and h2h_streak_win_rate > 0.6
	and prediction_2_p1_win > 0.6;

update table_tennis_matches 
set bet_on = 2, notes = 'qCv3'
where winner is null
	and h2h_p2 - h2h_p1 > 2
   	and h2h_streak_win_rate < 0.4
	and prediction_2_p1_win < 0.4;


----------------------------------------------------------------------------------------------------------

-- qDv1 accuracy : 0.5

update table_tennis_matches 
set bet_on = 1, notes = 'qDv2'
where winner is null
	and LENGTH(p1_p1last) > 0
	and LENGTH(p1_p2last) > 0
	and LENGTH(p2_p1last) > 0
	and LENGTH(p2_p2last) > 0
   	and h2h_streak_win_rate > 0.7
   	and prediction_raw_p1 > 0.7
   	and prediction_2_p1_win > 0.5;

update table_tennis_matches
set bet_on = 2, notes = 'qDv2'
where winner is null
	and LENGTH(p1_p1last) > 0
	and LENGTH(p1_p2last) > 0
	and LENGTH(p2_p1last) > 0
	and LENGTH(p2_p2last) > 0
   	and h2h_streak_win_rate < 0.3
   	and prediction_raw_p1 < 0.3
   	and prediction_2_p1_win < 0.5;


----------------------------------------------------------------------------------------------------------


--- clear old stall matches --

-- delete from table_tennis_matches where winner is null and DATE(match_time AT TIME ZONE 'AEST') = DATE((now() AT TIME ZONE 'AEST') - INTERVAL '1 days');


END;
$$;

-- SET prediction_3 = s.p1_won_avg
-- 	, prediction_3_win_count = s.p1_won_sum
-- 	, prediction_3_count = s.match_count
-- FROM (
--     SELECT
-- --         l10_p1 - l10_p2 as l10_gap
-- --         , l30_p1 - l30_p2 as l30_gap
--         p1_streak
-- 		, p2_streak
--         , SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum
-- 		, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg
--         , COUNT(*) AS match_count
--     FROM table_tennis_matches
--     WHERE winner IS NOT NULL
--     GROUP BY
-- --         l10_gap
-- --         , l30_gap
--         p1_streak
-- 		, p2_streak
-- ) AS s
-- WHERE
-- -- 	t.l10_p1 - t.l10_p2 = s.l10_gap
-- -- 	and t.l30_p1 - t.l30_p2 = s.l30_gap
-- 	t.p1_streak = s.p1_streak
-- 	and t.p2_streak = s.p2_streak;


UPDATE table_tennis_matches AS t
SET prediction_3 = s.p1_won_avg
	, prediction_3_win_count = s.p1_won_sum
	, prediction_3_count = s.match_count
FROM (
    SELECT
        p1_streak
		, p2_streak
		, h2h_p1
		, h2h_p2
		, bm_p1
		, bm_p2
		, l10_p1 - l10_p2 AS l10_gap
	    , l30_p1 - l30_p2 AS l30_gap
        , SUM(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum
		, AVG(CASE WHEN winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg
        , COUNT(*) AS match_count
    FROM table_tennis_matches
    WHERE winner IS NOT NULL
    GROUP BY
        p1_streak
		, p2_streak
		, h2h_p1
		, h2h_p2
		, bm_p1
		, bm_p2
		, l10_gap
		, l30_gap

) AS s
WHERE
	t.p1_streak = s.p1_streak
	and t.p2_streak = s.p2_streak
	and t.h2h_p1 = s.h2h_p1
	and t.h2h_p2 = s.h2h_p2
	and t.bm_p1 = s.bm_p1
	and t.bm_p2 = s.bm_p2
	and t.l10_p1 - t.l10_p2 = s.l10_gap
	and t.l30_p1 - t.l30_p2 = s.l30_gap
	and winner IS NULL;



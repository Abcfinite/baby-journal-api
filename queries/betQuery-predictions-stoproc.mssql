--- based on updated odds
-- qDv9 :
	-- 2025.11.04 - 0.71 (7)


update table_tennis_matches 
set bet_on = 1, notes = COALESCE(notes, '') || 'qDv9 '
where winner is null
	and bet_on is null
	and odd_p1_2 < odd_p1
	and prediction_p1_odd_only_win > 0.6;


update table_tennis_matches 
set bet_on = 2, notes = COALESCE(notes, '') || 'qDv9 '
where winner is null
	and bet_on is null
	and odd_p2_2 < odd_p2
	and prediction_p1_odd_only_win < 0.35;



--- based on updated odds
-- qEv1 : 
	-- 2025.11.04 - 0.6 (69)


update table_tennis_matches 
set bet_on = 1, notes = COALESCE(notes, '') || 'qEv2'
where winner is null
	and bet_on is null
	and prediction_great_p1_win > 0.5
	and great > 0.5
	and lest > 0.5;


update table_tennis_matches 
set bet_on = 2, notes = COALESCE(notes, '') || 'qEv2'
where winner is null
	and bet_on is null
	and prediction_great_p1_win < 0.5
	and great < 0.5
	and lest < 0.5;





update table_tennis_matches
set bet_on = 2, notes = COALESCE(notes, '') || 'qAv22 '
where winner is null
	and bet_on is null
	and prediction_p1_odd_only_win < 0.4
	and prediction_l10_p1_win_on < 0.4;



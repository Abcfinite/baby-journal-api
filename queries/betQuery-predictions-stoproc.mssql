-- update table_tennis_matches set prediction_raw_count_on = prediction_raw_count where winner is null;

-- update table_tennis_matches set prediction_raw_win_count_on = prediction_raw_win_count_on where winner is null;
-- update table_tennis_matches set prediction_p1_test_on = prediction_p1_test where winner is null;

----------------------------------------------------------------------------------------------------------



WITH t_to_update AS (
    -- 1. Identify the rows in the main table that need updating
    SELECT
        t.id,
		t.odd_p1,
        t.odd_p2
    FROM
        table_tennis_matches AS t
    WHERE
		DATE(match_time) = DATE((now() AT TIME ZONE 'Australia/Sydney'))
        AND t.winner IS NULL
        AND t.prediction_p1_odd_only_count IS NULL
),
t_with_stats AS (
    -- 2. Use a LATERAL join to calculate stats for each row identified in step 1
    SELECT
        t.id,
        s.p1_won_avg,
        s.p1_won_sum,
        s.match_count
    FROM
        t_to_update AS t
    -- LATERAL is now joining a CTE to a subquery, which is a fully supported pattern.
    CROSS JOIN LATERAL (
        SELECT
            AVG(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg,
            SUM(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum,
            COUNT(*) AS match_count
        FROM
            table_tennis_matches AS s_inner
        WHERE
            s_inner.winner IS NOT NULL
            AND ABS(t.odd_p1 - s_inner.odd_p1) <= 0.05
            AND ABS(t.odd_p2 - s_inner.odd_p2) <= 0.05
    ) AS s
    WHERE s.match_count > 0 -- Only keep rows where similar matches were found
)
-- 3. Perform the UPDATE using the calculated stats from the CTE
UPDATE table_tennis_matches AS t
SET
    prediction_p1_odd_only_win = ts.p1_won_avg,
    prediction_p1_odd_only_count = ts.p1_won_sum
FROM
    t_with_stats AS ts
WHERE
	t.id = ts.id;




WITH t_to_update AS (
    -- 1. Identify the rows in the main table that need updating
    SELECT
        t.id,
-- 		t.match_time,
        t.prediction_p1_win_on,
        t.prediction_l10_p1_win_on,
		t.h2h_streak_win_rate_on
    FROM
        table_tennis_matches AS t
    WHERE
-- 		DATE(t.match_time) >= DATE((now() AT TIME ZONE 'Australia/Sydney')) - INTERVAL '2 days'
        t.winner IS NULL
        AND t.prediction_2_rev_p1_win_count IS NULL
),
t_with_stats AS (
    -- 2. Use a LATERAL join to calculate stats for each row identified in step 1
    SELECT
        t.id,
        s.p1_won_avg,
        s.p1_won_sum,
        s.match_count
    FROM
        t_to_update AS t
    -- LATERAL is now joining a CTE to a subquery, which is a fully supported pattern.
    CROSS JOIN LATERAL (
        SELECT
            AVG(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg,
            SUM(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum,
            COUNT(*) AS match_count
        FROM
            table_tennis_matches AS s_inner
        WHERE
            s_inner.winner IS NOT NULL
            AND ABS(t.prediction_p1_win_on - s_inner.prediction_p1_win_on) <= 0.05
            AND ABS(t.prediction_l10_p1_win_on - s_inner.prediction_l10_p1_win_on) <= 0.05
			AND ABS(t.h2h_streak_win_rate_on - s_inner.h2h_streak_win_rate_on) <= 0.05
    ) AS s
    WHERE s.match_count > 0 -- Only keep rows where similar matches were found
)
-- 3. Perform the UPDATE using the calculated stats from the CTE
UPDATE table_tennis_matches AS t
SET
    prediction_2_rev_p1_win = ts.p1_won_avg,
    prediction_2_rev_p1_win_count = ts.p1_won_sum,
    prediction_2_rev_match_no = ts.match_count
FROM
    t_with_stats AS ts
WHERE
	t.id = ts.id;

	

update table_tennis_matches set prediction_2_rev_p1_win_on = prediction_2_rev_p1_win where winner is null;
update table_tennis_matches set prediction_2_rev_match_no_on = prediction_2_rev_match_no where winner is null;








WITH t_to_update AS (
    -- 1. Identify the rows in the main table that need updating
    SELECT
        t.id,
		t.match_time,
        t.odd_p1,
        t.odd_p2,
		t.prediction_2_rev_p1_win
    FROM
        table_tennis_matches AS t
    WHERE
		DATE(match_time) = DATE((now() AT TIME ZONE 'Australia/Sydney'))
        and t.winner IS NULL
        AND t.prediction_p1_odd_count IS NULL
),
t_with_stats AS (
    -- 2. Use a LATERAL join to calculate stats for each row identified in step 1
    SELECT
        t.id,
        s.p1_won_avg,
        s.p1_won_sum,
        s.match_count
    FROM
        t_to_update AS t
    -- LATERAL is now joining a CTE to a subquery, which is a fully supported pattern.
    CROSS JOIN LATERAL (
        SELECT
            AVG(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg,
            SUM(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum,
            COUNT(*) AS match_count
        FROM
            table_tennis_matches AS s_inner
        WHERE
            s_inner.winner IS NOT NULL
            AND ABS(t.odd_p1 - s_inner.odd_p1) < 0.1
            AND ABS(t.odd_p2 - s_inner.odd_p2) < 0.1
			AND ABS(t.prediction_2_rev_p1_win - s_inner.prediction_2_rev_p1_win) < 0.05
    ) AS s
    WHERE s.match_count > 0 -- Only keep rows where similar matches were found
)
-- 3. Perform the UPDATE using the calculated stats from the CTE
UPDATE table_tennis_matches AS t
SET
    prediction_p1_odd_win = ts.p1_won_avg,
--     prediction_2_rev_p1_win_count = ts.p1_won_sum,
    prediction_p1_odd_count = ts.match_count
FROM
    t_with_stats AS ts
WHERE
-- 	t.winner is null
-- 	and prediction_2_rev_p1_win_count is null
   	t.id = ts.id;
	
	
update table_tennis_matches set prediction_p1_odd_win_on = prediction_p1_odd_win where winner is null;
update table_tennis_matches set prediction_p1_odd_count_on = prediction_p1_odd_count where winner is null;






WITH t_to_update AS (
    -- 1. Identify the rows in the main table that need updating
    SELECT
        t.id,
		t.match_time,
        t.odd_p1,
        t.odd_p2,
		t.prediction_2_rev_p1_win_on,
		t.h2h_streak_win_rate_on
    FROM
        table_tennis_matches AS t
    WHERE
		DATE(match_time) = DATE((now() AT TIME ZONE 'Australia/Sydney'))
-- 		DATE(match_time) = DATE((now() AT TIME ZONE 'Australia/Sydney') - INTERVAL '1 days')
		and t.winner IS NULL
--         AND t.prediction_p1_odd_count IS NULL
),
t_with_stats AS (
    -- 2. Use a LATERAL join to calculate stats for each row identified in step 1
    SELECT
        t.id,
        s.p1_won_avg,
        s.p1_won_sum,
        s.match_count
    FROM
        t_to_update AS t
    -- LATERAL is now joining a CTE to a subquery, which is a fully supported pattern.
    CROSS JOIN LATERAL (
        SELECT
            AVG(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg,
            SUM(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum,
            COUNT(*) AS match_count
        FROM
            table_tennis_matches AS s_inner
        WHERE
            s_inner.winner IS NOT NULL
            AND ABS(t.odd_p1 - s_inner.odd_p1) < 0.05
            AND ABS(t.odd_p2 - s_inner.odd_p2) < 0.05
			AND ABS(t.prediction_2_rev_p1_win_on - s_inner.prediction_2_rev_p1_win_on) < 0.05
			AND ABS(t.h2h_streak_win_rate_on - s_inner.h2h_streak_win_rate_on) < 0.05
    ) AS s
    WHERE s.match_count > 0 -- Only keep rows where similar matches were found
)
-- 3. Perform the UPDATE using the calculated stats from the CTE
UPDATE table_tennis_matches AS t
SET
    prediction_4_p1_win = ts.p1_won_avg,
--     prediction_2_rev_p1_win_count = ts.p1_won_sum,
    prediction_4_p1_count = ts.match_count
FROM
    t_with_stats AS ts
WHERE
-- 	t.winner is null
-- 	and prediction_2_rev_p1_win_count is null
   	t.id = ts.id;
	


update table_tennis_matches set prediction_4_p1_win_on = prediction_4_p1_win where winner is null;
update table_tennis_matches set prediction_4_p1_count_on = prediction_4_p1_count where winner is null;

	
----------------------------------------------------------------------------------------------------------



WITH t_to_update AS (
    -- 1. Identify the rows and calculate the stat columns ONCE
    SELECT
        t.id
        , greatest(t.prediction_p1_win_on, t.h2h_streak_win_rate_on, t.prediction_2_p1_win_on, t.prediction_l10_p1_win_on, t.prediction_2_rev_p1_win_on) AS great
        , least(t.prediction_p1_win_on, t.h2h_streak_win_rate_on, t.prediction_2_p1_win_on, t.prediction_l10_p1_win_on, t.prediction_2_rev_p1_win_on) AS lest
        , t.prediction_p1_win_on + t.h2h_streak_win_rate_on + t.prediction_2_p1_win_on + t.prediction_l10_p1_win_on + t.prediction_2_rev_p1_win_on AS multi
    FROM
        table_tennis_matches AS t
    WHERE
        DATE(match_time) = DATE((NOW() AT TIME ZONE 'Australia/Sydney'))
--         AND t.winner IS NULL
),
t_with_stats AS (
    -- 2. Join the identified rows (t) to similar historical rows (s_inner)
    SELECT
        t.id,
        s.p1_won_avg,
        s.p1_won_sum,
        s.match_count
    FROM
        t_to_update AS t
    CROSS JOIN LATERAL (
        SELECT
            AVG(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_avg,
            SUM(CASE WHEN s_inner.winner = 1 THEN 1.0 ELSE 0 END) AS p1_won_sum,
            COUNT(*) AS match_count
        FROM
            table_tennis_matches AS s_inner
        WHERE
            s_inner.winner IS NOT NULL
            -- FIX: Recalculate the comparison stats for the historical row (s_inner)
            AND ABS(t.great - greatest(s_inner.prediction_p1_win_on, s_inner.h2h_streak_win_rate_on, s_inner.prediction_2_p1_win_on, s_inner.prediction_l10_p1_win_on, s_inner.prediction_2_rev_p1_win_on)) < 0.02
            AND ABS(t.lest - least(s_inner.prediction_p1_win_on, s_inner.h2h_streak_win_rate_on, s_inner.prediction_2_p1_win_on, s_inner.prediction_l10_p1_win_on, s_inner.prediction_2_rev_p1_win_on)) < 0.02
            AND ABS(t.multi - (s_inner.prediction_p1_win_on + s_inner.h2h_streak_win_rate_on + s_inner.prediction_2_p1_win_on + s_inner.prediction_l10_p1_win_on + s_inner.prediction_2_rev_p1_win_on)) < 0.02
    ) AS s
    WHERE s.match_count > 0
)
-- 3. Perform the UPDATE using the calculated stats from the CTE
UPDATE table_tennis_matches AS t
SET
    prediction_great_p1_win = ts.p1_won_avg,
    prediction_great_p1_count = ts.match_count
FROM
    t_with_stats AS ts
WHERE
    t.id = ts.id;



